---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { updates } from '../data/updates';
import { site } from '../data/site';

const notes = (await getCollection('notes')).filter((entry) => !entry.data.draft);
const recent = [
  ...updates.map((item) => ({ ...item, when: new Date(item.date) })),
  ...notes.map((entry) => ({
    kind: 'Note' as const,
    title: entry.data.title,
    href: `/notes/${entry.id}/`,
    when: entry.data.date,
  })),
]
  .sort((a, b) => b.when.getTime() - a.when.getTime())
  .slice(0, 4);
---

<BaseLayout title="Jevan Luo" page="home">
  <div class="cover" role="img" aria-label="Quiet campus scene"></div>
  <a class="portrait-home" href="#top" aria-label="Jevan Luo, return to top">
    <img src="/images/portrait.png" alt="Illustrated portrait placeholder" width="104" height="104" />
  </a>
  <div class="page-layout" id="top">
    <Sidebar page="home" />
    <main class="page-main">
      <section class="bio">
        <h1>Hello, I’m Jevan Luo.</h1>
        <p class="bio-copy">I study how we can draw careful conclusions from assessments and the models we use to understand them.</p>
        <p class="bio-copy secondary">This site brings together my publications, short methodological notes, and ideas still taking shape. I welcome conversations with people working on related questions.</p>
        <a class="quick-link" href="/research/">Browse research ↗</a>
      </section>

      <section class="updates" aria-labelledby="recent-updates-title">
        <div class="section-head"><h2 id="recent-updates-title">Recent updates</h2><span>A short, curated list</span></div>
        {recent.length ? recent.map((item) => (
          <a class="update-row" href={item.href}>
            <span class="update-kind">{item.kind}</span><span class="update-title">{item.title}</span><span class="update-arrow" aria-hidden="true">↗</span>
          </a>
        )) : <p class="empty-line">Updates will appear here as notes and research are added.</p>}
      </section>

      <section class="collaboration" aria-labelledby="collaboration-title">
        <div><h2 id="collaboration-title">Let’s collaborate.</h2><p>If you see a connection to your work in measurement, assessment, or methods, I would be glad to hear from you.</p></div>
        {site.email && <a class="email-link" href={`mailto:${site.email}`}>Email ↗</a>}
      </section>
      <footer class="site-footer">© {new Date().getFullYear()} Jevan Luo</footer>
    </main>
  </div>
</BaseLayout>
